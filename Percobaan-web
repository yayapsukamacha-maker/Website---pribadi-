<script>
let authMode='login', current=''; 
const $=id=>document.getElementById(id);
function getUsers(){try{return JSON.parse(localStorage.getItem('yapz_users')||'{}')}catch(e){return {}}}
function showAuth(mode){authMode=mode;$('loginTab').className=mode==='login'?'btn':'btn secondary';$('registerTab').className=mode==='register'?'btn':'btn secondary';$('authSubmit').textContent=mode==='login'?'Masuk':'Buat akun';$('password').autocomplete=mode==='login'?'current-password':'new-password';$('authStatus').textContent=''}
async function hashPassword(p){const data=new TextEncoder().encode(p);const hash=await crypto.subtle.digest('SHA-256',data);return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,'0')).join('')}
$('authForm').addEventListener('submit',async e=>{e.preventDefault();const u=$('username').value.trim(),p=$('password').value;if(!/^[a-zA-Z0-9_]{3,24}$/.test(u)){ $('authStatus').textContent='Username 3–24 karakter: huruf, angka, atau _.';return}if(p.length<6){$('authStatus').textContent='Password minimal 6 karakter.';return}let users=getUsers();if(authMode==='register'){if(users[u]){$('authStatus').textContent='Username sudah digunakan.';return}users[u]={passwordHash:await hashPassword(p),createdAt:new Date().toISOString()};localStorage.setItem('yapz_users',JSON.stringify(users));$('authStatus').textContent='Akun demo dibuat. Silakan login.';showAuth('login');$('username').value=u;$('password').value=''}else{if(!users[u]||users[u].passwordHash!==await hashPassword(p)){$('authStatus').textContent='Username atau password salah.';return}enterApp(u)}});
function enterApp(u){current=u;$('authView').classList.add('hidden');$('appView').classList.remove('hidden');$('helloName').textContent=u;$('currentUser').textContent=u;renderUsers();updateWorldClock();loadPrayerTimes()}
function logout(){current='';$('appView').classList.add('hidden');$('authView').classList.remove('hidden');$('authForm').reset();showAuth('login')}
function renderUsers(){const users=getUsers();const names=Object.keys(users);$('userList').innerHTML=names.length?names.map(n=>'<div class="prayer-row"><span>'+escapeHtml(n)+'</span><span>Terdaftar</span></div>').join(''):'Belum ada akun di browser ini.'}
function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
let expr='';function calcDraw(){$('calcDisplay').value=expr||'0'}function calcAdd(v){if(expr.length<45){expr+=v;calcDraw()}}function calcClear(){expr='';calcDraw()}function calcBack(){expr=expr.slice(0,-1);calcDraw()}function calcResult(){try{if(!/^[0-9+\-*/(). ]+$/.test(expr))throw Error();let result=Function('"use strict";return ('+expr+')')();if(!Number.isFinite(result))throw Error();expr=String(Math.round(result*1e8)/1e8);calcDraw()}catch(e){$('calcDisplay').value='Error';expr=''}}
let answer=0;function newGame(){answer=Math.floor(Math.random()*20)+1;$('guessInput').value='';$('gameStatus').textContent='Angka baru sudah dipilih. Tebak!'}function guess(){const n=Number($('guessInput').value);if(!Number.isInteger(n)||n<1||n>20){$('gameStatus').textContent='Masukkan angka 1–20.';return}$('gameStatus').textContent=n===answer?'🎉 Benar! Hebat!':n<answer?'Terlalu kecil. Coba lagi!':'Terlalu besar. Coba lagi!';if(n===answer)newGame()}
function updateWorldClock(){const z=$('zone').value,now=new Date();$('worldClock').textContent=new Intl.DateTimeFormat('id-ID',{timeZone:z,hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(now);$('worldDate').textContent=new Intl.DateTimeFormat('id-ID',{timeZone:z,dateStyle:'full'}).format(now)}
async function loadPrayerTimes(){const city=$('city').value;$('prayerList').innerHTML='<p class="muted">Memuat jadwal...</p>';$('prayerStatus').textContent='';try{const url='https://api.aladhan.com/v1/timingsByCity?city='+encodeURIComponent(city)+'&country=Indonesia&method=20';const r=await fetch(url);if(!r.ok)throw Error();const j=await r.json();if(j.code!==200)throw Error();const t=j.data.timings;const items=[['Subuh',t.Fajr],['Zuhur',t.Dhuhr],['Asar',t.Asr],['Magrib',t.Maghrib],['Isya',t.Isha]];$('prayerList').innerHTML=items.map(([n,v])=>'<div class="prayer-row"><span>'+n+'</span><b>'+v+'</b></div>').join('');$('prayerStatus').textContent='Tanggal: '+j.data.date.readable}catch(e){$('prayerList').innerHTML='<p class="muted">Jadwal tidak dapat dimuat. Periksa koneksi internet.</p>'}}
setInterval(updateWorldClock,1000);newGame();showAuth('login');
</script>
</body>
</html>'''

